.DS_Store
.claude/
__pycache__/
demo/video.mp4
# Screenshots, captures and videos never go to GitHub (Roger, 2026-11-17).
# Only sprite art (src2/sprites) and built sprites (out2/sprites) are tracked.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov
!src2/sprites/*.png
!out2/sprites/*.webp

# Perf harness: paired Electron profile (session cookie) and generated preview page.
perf/profile/
perf/data/inline.html
# Perf harness: per-run process lists of the test machine stay local (Roger, 2026-11-18).
perf/data/*/system.log
